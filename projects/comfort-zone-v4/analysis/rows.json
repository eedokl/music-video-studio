[{"section": "verse1", "text": "Brüssel City, Montag früh,", "header": "[verse1]"}, {"section": "verse1", "text": "another meeting, same old view.", "header": "[verse1]"}, {"section": "verse1", "text": "PowerPoint und Strategien,", "header": "[verse1]"}, {"section": "verse1", "text": "while the future's on amphetamines.", "header": "[verse1]"}, {"section": "verse1", "text": "Silicon Valley sagt: \"Let's go!\"", "header": "[verse1]"}, {"section": "verse1", "text": "Europa sagt: \"Wir prüfen das noch.\"", "header": "[verse1]"}, {"section": "verse1", "text": "Fünf Ausschüsse und ein Bericht,", "header": "[verse1]"}, {"section": "verse1", "text": "doch die Konkurrenz schläft heute nicht.", "header": "[verse1]"}, {"section": "verse1", "text": "Und Caroline schaut aus dem Fenster raus,", "header": "[verse1]"}, {"section": "verse1", "text": "sieht den Himmel über'm Berlaymont-Haus.", "header": "[verse1]"}, {"section": "verse1", "text": "She says:", "header": "[verse1]"}, {"section": "verse1", "text": "\"Maybe we're discussing 'yesterday'...\"", "header": "[verse1]"}, {"section": "chorus", "text": "Out of the comfort zone, into the storm,", "header": "[chorus]"}, {"section": "chorus", "text": "wir wollten die Zukunft, now it's already born.", "header": "[chorus]"}, {"section": "chorus", "text": "Out of the comfort zone, can you survive?", "header": "[chorus]"}, {"section": "chorus", "text": "Europe twenty thirty one – are we still alive?", "header": "[chorus]"}, {"section": "chorus", "text": "Hey! Hey! Wake up, Baby, wake up now!", "header": "[chorus]"}, {"section": "chorus", "text": "Hey! Wake up, Baby, wake up now!", "header": "[chorus]"}, {"section": "verse2", "text": "Christian sitzt in San Francisco Bay,", "header": "[verse2]"}, {"section": "verse2", "text": "AI schreibt seinen Code all day.", "header": "[verse2]"}, {"section": "verse2", "text": "Agent für Agent, token by token,", "header": "[verse2]"}, {"section": "verse2", "text": "alte Gewissheiten werden gebrochen.", "header": "[verse2]"}, {"section": "verse2", "text": "\"Bubble!\" rufen sie im Konferenzraum,", "header": "[verse2]"}, {"section": "verse2", "text": "doch draußen wächst ein neuer Traum.", "header": "[verse2]"}, {"section": "verse2", "text": "Compute, Capital, Energy,", "header": "[verse2]"}, {"section": "verse2", "text": "that's the new geopolitics, baby.", "header": "[verse2]"}, {"section": "verse2", "text": "Newsflash!", "header": "[verse2]"}, {"section": "verse2", "text": "Ladies and Gentlemen...", "header": "[verse2]"}, {"section": "verse2", "text": "Willkommen zur europäischen Spezialität:", "header": "[verse2]"}, {"section": "verse2", "text": "Zuerst regulieren. Dann analysieren.", "header": "[verse2]"}, {"section": "verse2", "text": "Dann evaluieren. Dann diskutieren.", "header": "[verse2]"}, {"section": "verse2", "text": "...und dann wundern wir uns,", "header": "[verse2]"}, {"section": "verse2", "text": "warum alle Gründer am Flughafen stehen.", "header": "[verse2]"}, {"section": "chorus", "text": "Out of the comfort zone, into the storm,", "header": "[chorus]"}, {"section": "chorus", "text": "wir wollten die Zukunft, now it's already born.", "header": "[chorus]"}, {"section": "chorus", "text": "Out of the comfort zone, can you survive?", "header": "[chorus]"}, {"section": "chorus", "text": "Europe twenty thirty one – are we still alive?", "header": "[chorus]"}, {"section": "chorus", "text": "Hey! Hey! Wake up, Baby, wake up now!", "header": "[chorus]"}, {"section": "bridge", "text": "Kein Drama, kein Weltuntergang.", "header": "[bridge]"}, {"section": "bridge", "text": "Nur eine Frage:", "header": "[bridge]"}, {"section": "bridge", "text": "Wenn die nächste industrielle Revolution stattfindet,", "header": "[bridge]"}, {"section": "bridge", "text": "und keiner von uns erscheint—", "header": "[bridge]"}, {"section": "bridge", "text": "who gets to write the rules?", "header": "[bridge]"}, {"section": "final", "text": "Out of the comfort zone, into the light,", "header": "[final]"}, {"section": "final", "text": "maybe we're losing, maybe we still can fight.", "header": "[final]"}, {"section": "final", "text": "Out of the comfort zone, one last chance,", "header": "[final]"}, {"section": "final", "text": "Europa, komm schon, start the dance.", "header": "[final]"}, {"section": "final", "text": "Hey! Hey!", "header": "[final]"}, {"section": "final", "text": "No more \"maybe\". No more \"later\".", "header": "[final]"}, {"section": "final", "text": "Twenty thirty one is coming,", "header": "[final]"}, {"section": "final", "text": "and time doesn't wait.", "header": "[final]"}]